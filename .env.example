# Copy to .env.local and fill in. In Dokploy, set these under Environment.
DATABASE_URI=postgres://<user>@localhost:5432/velarcloud_dev
# openssl rand -base64 32
PAYLOAD_SECRET=replace_with_openssl_rand_base64_32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Quick local experiments only — never commit or set in Dokploy.
# Schema changes go through `npm run migrate:create` → `npm run migrate`.
PAYLOAD_PUSH=false

# Outgoing email (Payload auth emails). Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Or hex-encoded (wins over SMTP_PASS), for passwords env editors mangle: node -p "Buffer.from(process.argv[1]).toString('hex')" '<pass>'
SMTP_PASS_HEX=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=VelarCloud
